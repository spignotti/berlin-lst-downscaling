{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(uv run nox:*)",
      "Bash(uv run --locked nox:*)",
      "Bash(uv run pytest:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(gh:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout -b:*)",
      "Bash(git checkout -B:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git worktree add:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  }
}

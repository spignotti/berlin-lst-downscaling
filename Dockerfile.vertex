# syntax=docker/dockerfile:1
# Bounded Vertex GPU acceptance image for the modeling smoke (issue #38).
#
# Carries the locked Linux/amd64 project stack and the pinned Infisical CLI used
# to inject WANDB_API_KEY at runtime from the vault. No secret is baked in: the
# image holds source code, locked dependencies, and the runtime entrypoint only.
# CUDA runtime libraries come from the torch 2.2.2 wheel; the GPU driver is
# provided by the Vertex worker and is only proven by the acceptance run.
FROM python:3.12-slim-bookworm@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_NO_SYNC=1 \
    PATH="/opt/venv/bin:/usr/local/bin:$PATH"

COPY --from=ghcr.io/astral-sh/uv:0.7.2@sha256:3b898ca84fbe7628c5adcd836c1de78a0f1ded68344d019af8478d4358417399 /uv /uvx /usr/local/bin/

# Pinned, checksum-verified Infisical CLI for runtime secret injection.
ARG INFISICAL_CLI_VERSION=0.43.137
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && cd /tmp \
    && curl -fsSLO "https://github.com/Infisical/cli/releases/download/v${INFISICAL_CLI_VERSION}/cli_${INFISICAL_CLI_VERSION}_linux_amd64.tar.gz" \
    && curl -fsSL -o checksums.txt "https://github.com/Infisical/cli/releases/download/v${INFISICAL_CLI_VERSION}/checksums.txt" \
    && grep " cli_${INFISICAL_CLI_VERSION}_linux_amd64.tar.gz$" checksums.txt | sha256sum -c - \
    && tar -xzf "cli_${INFISICAL_CLI_VERSION}_linux_amd64.tar.gz" -C /usr/local/bin infisical \
    && rm -f "cli_${INFISICAL_CLI_VERSION}_linux_amd64.tar.gz" checksums.txt \
    && infisical --version

WORKDIR /app

# Dependency layer: copy only the manifests so it caches until deps change.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

# Source layer.
COPY src ./src
COPY scripts ./scripts
COPY configs ./configs
RUN uv sync --frozen --no-dev

# Writable local output surface for the non-root runtime user: checkpoints,
# logs, data_scope.json, and the W&B save dir all live under the run's local
# output root (data/runs/vertex-smoke/<label>).
RUN useradd --create-home --uid 1000 runner \
    && mkdir -p /app/data/runs/vertex-smoke \
    && chown -R runner:runner /app
USER runner

ENTRYPOINT ["/app/scripts/operators/vertex_entrypoint.sh"]

# Leave unset. Local GCS uses user ADC (`gcloud auth application-default login`).
# A JSON key path here overrides ADC and breaks access to the canonical bucket.
# GOOGLE_APPLICATION_CREDENTIALS=

# Weights & Biases API key for experiment tracking
WANDB_API_KEY=

# NASA Earthdata token for LP DAAC / CMR access (ECOSTRESS listing)
EARTHDATA_TOKEN=

# NASA Earthdata Login credentials for AppEEARS API authentication
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

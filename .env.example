# Names only; never commit values. Values live in Infisical (EU,
# https://eu.infisical.com), thesis project, environment `dev`.
# Fill a local .env (gitignored) only where a tool needs it; on the VM,
# scripts/runners/vm/sync-vm-env.sh writes .env from Infisical.

# NASA Earthdata (ECOSTRESS, ASTER GED) — Infisical folder /data
EARTHDATA_TOKEN=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Weights & Biases — Infisical folder /vertex (Vertex jobs inject it at runtime)
WANDB_API_KEY=

# Operator machine only: Infisical Universal Auth for the thesis project, read by
# scripts/operators/_infisical_auth.sh. Keep the values outside the repository.
# INFISICAL_THESIS_CLIENT_ID=
# INFISICAL_THESIS_CLIENT_SECRET=

# GOOGLE_APPLICATION_CREDENTIALS is not set here: scripts/operators/with-gcp-operator.sh
# sets it per command from the operator SA key (Infisical folder /operator).
